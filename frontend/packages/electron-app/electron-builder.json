{
  "appId": "astron-rpa",
  "productName": "astron-rpa",
  "artifactName": "星辰RPA-${version}-${arch}.${ext}",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "asar": false,
  "files": [
    "out/**",
    "extensions/**",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "../../public/icons/icon.ico",
    "publisherName": "astron-rpa",
    "verifyUpdateCodeSignature": false,
    "publish": {
      "provider": "generic",
      "url": ""
    },
    "extraFiles": [
      {
        "from": "../../../resources",
        "to": "resources"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": "../../public/icons/icon.png",
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extraResources": [
      {
        "from": "../../../resources/${arch}",
        "to": ".",
        "filter": ["python_core.tar.gz", "python_core.tar.gz.sha256.txt"]
      },
      {
        "from": "../../../resources",
        "to": ".",
        "filter": [
          "**/*",
          "!*.exe",
          "!*.7z",
          "!*.7z.sha256.txt",
          "!arm64${/*}",
          "!x64${/*}",
          "!python_core.tar.gz",
          "!python_core.tar.gz.sha256.txt"
        ]
      }
    ],
    "extendInfo": {
      "NSAppleEventsUsageDescription": "AstronRPA needs to send Apple Events to control other applications for RPA automation.",
      "NSAccessibilityUsageDescription": "AstronRPA needs Accessibility permission to pick and operate UI elements.",
      "NSScreenCaptureUsageDescription": "AstronRPA needs Screen Recording permission to capture the desktop and highlight elements.",
      "NSInputMonitoringUsageDescription": "AstronRPA needs Input Monitoring permission for global hotkeys and recording.",
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "com.iflytek.astronrpa",
          "CFBundleURLSchemes": ["astronrpa"]
        }
      ]
    }
  },
  "linux": {
    "target": "deb",
    "icon": "../../public/icons/icon.png",
    "category": "Utility",
    "desktop": {
      "MimeType": "x-scheme-handler/astronrpa;"
    },
    "extraFiles": [
      {
        "from": "../../../resources",
        "to": "resources",
        "filter": ["**/*", "!*.exe"]
      },
      {
        "from": "../../../engine/shared/astronverse-browser-plugin/src/astronverse/browser_plugin/plugins",
        "to": "resources/browser-plugins"
      }
    ]
  },
  "deb": {
    "afterInstall": "build/linux/after-install.sh",
    "depends": [
      "gir1.2-atspi-2.0",
      "at-spi2-core",
      "libgirepository-1.0-1",
      "xdotool",
      "x11-utils",
      "wmctrl",
      "ffmpeg",
      "libgtk-3-0"
    ]
  },
  "nsis": {
    "include": "./installer.nsh",
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "星辰RPA"
  }
}
